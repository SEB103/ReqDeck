// This file is generated by CMake from cmake/versioninfo.rc.in
// (see cmake/WindowsVersionInfo.cmake). Do not edit the generated .rc;
// change packaging/product.json or the reqdeck_add_windows_version_info() call.
//
// Windows resource script for one executable: an optional Explorer/taskbar
// icon plus a VERSIONINFO block so the .exe carries product name, version,
// publisher and copyright metadata. Product values come from product.json;
// the file description is per executable.

#include <windows.h>

@PRODUCT_RC_ICON_STATEMENT@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PRODUCT_VERSION_MAJOR@,@PRODUCT_VERSION_MINOR@,@PRODUCT_VERSION_PATCH@,@PRODUCT_VERSION_BUILD@
 PRODUCTVERSION @PRODUCT_VERSION_MAJOR@,@PRODUCT_VERSION_MINOR@,@PRODUCT_VERSION_PATCH@,@PRODUCT_VERSION_BUILD@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@PRODUCT_PUBLISHER@"
            VALUE "FileDescription",  "@PRODUCT_RC_FILE_DESCRIPTION@"
            VALUE "FileVersion",      "@PRODUCT_VERSION@"
            VALUE "InternalName",     "@PRODUCT_RC_EXE_NAME@"
            VALUE "LegalCopyright",   "@PRODUCT_COPYRIGHT@"
            VALUE "OriginalFilename", "@PRODUCT_RC_EXE_NAME@.exe"
            VALUE "ProductName",      "@PRODUCT_DISPLAY_NAME@"
            VALUE "ProductVersion",   "@PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
