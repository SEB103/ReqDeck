// This file is generated by CMake from cmake/productinfo.h.in.
// Do not edit the generated header; change packaging/product.json instead.
//
// Compile-time product identity, centralized in packaging/product.json. The
// display name is separate from the stable identifier so the product can be
// renamed without changing QSettings paths, data directories, or the update
// component id.

#ifndef PRODUCTINFO_H
#define PRODUCTINFO_H

// Human-readable product name (the one value to change on a rename).
#define PRODUCT_DISPLAY_NAME "@PRODUCT_DISPLAY_NAME@"

// Stable identifier: QSettings organization/application name, data-directory
// base, and translation-file stem. Must not change across a rename.
#define PRODUCT_IDENTIFIER "@PRODUCT_IDENTIFIER@"

// Stable organization domain used by QSettings/QStandardPaths.
#define PRODUCT_ORG_DOMAIN "@PRODUCT_ORG_DOMAIN@"

// Semantic product version (MAJOR.MINOR.PATCH).
#define PRODUCT_VERSION "@PRODUCT_VERSION@"

// Publisher shown in About and installer metadata.
#define PRODUCT_ORGANIZATION "@PRODUCT_PUBLISHER@"

// Copyright line for the application's own source code.
#define PRODUCT_COPYRIGHT "@PRODUCT_COPYRIGHT@"

// Project homepage URL.
#define PRODUCT_HOMEPAGE "@PRODUCT_HOMEPAGE@"

// In-app update-check gate. When false, a check reports "not yet available"
// without any network access; flip update.enabled in product.json to turn it on.
#define PRODUCT_UPDATE_ENABLED @PRODUCT_UPDATE_ENABLED_BOOL@

// GitHub Releases API endpoint queried for the latest published version.
#define PRODUCT_UPDATE_RELEASES_API "@PRODUCT_UPDATE_RELEASES_API@"

// Human-facing releases page opened when a newer version is available.
#define PRODUCT_UPDATE_RELEASES_PAGE "@PRODUCT_UPDATE_RELEASES_PAGE@"

// Base name (without .exe) of the Qt Installer Framework Maintenance Tool that
// an installed copy finds next to the executable; the in-app updater starts it.
#define PRODUCT_MAINTENANCE_TOOL_NAME "@PRODUCT_MAINTENANCE_TOOL_NAME@"

#endif // PRODUCTINFO_H
