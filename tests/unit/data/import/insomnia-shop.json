{
  "_type": "export",
  "__export_format": 4,
  "__export_source": "insomnia.desktop.app:v8.6.1",
  "resources": [
    {"_id": "wrk_1", "_type": "workspace", "name": "Shop", "parentId": null},
    {"_id": "env_base", "_type": "environment", "parentId": "wrk_1", "name": "Base Environment",
     "data": {"baseUrl": "https://shop.test"}},
    {"_id": "env_dev", "_type": "environment", "parentId": "env_base", "name": "Dev",
     "data": {"token": "dev-token", "limits": {"page": 10}}},
    {"_id": "fld_1", "_type": "request_group", "parentId": "wrk_1", "name": "Orders",
     "authentication": {"type": "bearer", "token": "{{ _.token }}"}},
    {"_id": "req_1", "_type": "request", "parentId": "fld_1", "name": "List orders", "method": "GET",
     "url": "{{ _.baseUrl }}/orders",
     "parameters": [{"name": "page", "value": "1"}, {"name": "off", "value": "x", "disabled": true}],
     "headers": [{"name": "Accept", "value": "application/json"}],
     "authentication": {}, "body": {}},
    {"_id": "req_2", "_type": "request", "parentId": "fld_1", "name": "Create order", "method": "POST",
     "url": "{{ _.baseUrl }}/orders",
     "body": {"mimeType": "application/json", "text": "{\"id\": \"{% uuid 'v4' %}\"}"},
     "authentication": {"type": "none"},
     "preRequestScript": "insomnia.environment.set('a', 1);"},
    {"_id": "req_3", "_type": "request", "parentId": "wrk_1", "name": "Login", "method": "POST",
     "url": "{{ _.baseUrl }}/login",
     "body": {"mimeType": "application/x-www-form-urlencoded", "params": [{"name": "user", "value": "{{ _.user }}"}]},
     "authentication": {"type": "basic", "username": "{{ _.user }}", "password": "{{ _.pass }}"}},
    {"_id": "req_4", "_type": "request", "parentId": "wrk_1", "name": "Upload", "method": "POST",
     "url": "{{ _.baseUrl }}/files",
     "body": {"mimeType": "multipart/form-data", "params": [{"name": "f", "type": "file"}]},
     "authentication": {"type": "oauth2"}},
    {"_id": "req_5", "_type": "request", "parentId": "wrk_1", "name": "Key", "method": "GET",
     "url": "{{ _.baseUrl }}/k",
     "authentication": {"type": "apikey", "key": "X-Key", "value": "{{ _.key }}", "addTo": "queryParams"}},
    {"_id": "jar_1", "_type": "cookie_jar", "parentId": "wrk_1", "name": "Default Jar", "cookies": []}
  ]
}
